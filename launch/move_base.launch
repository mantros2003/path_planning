<?xml version="1.0"?>
<launch>
    <node pkg="move_base" type="move_base" respawn="fasle" name="move_base" output="screen">
        <param name="base_global_planner" value="custom_nav/DjikstraPlanner">

        <rosparam file="$(find custom_nav)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find custom_nav)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find custom_nav)/config/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find custom_nav)/config/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find custom_nav)/config/base_local_planner.yaml" command="load" />

        <param name="planner_frequency" value="1.0" />
        <param name="controller_frequency" value="10.0" />
    </node>
</launch>
